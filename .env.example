# ============================================
# StatusWatch — Environment Variables
# ============================================
# Salin file ini menjadi .env.local dan isi nilainya.
# Jangan commit .env.local ke repository!

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # SERVER ONLY, jangan pakai NEXT_PUBLIC_

# Cron
CRON_SECRET=                      # string acak panjang (>= 32 karakter)

# App
NEXT_PUBLIC_APP_URL=              # contoh: https://statuswatch.vercel.app

# P2 (opsional)
RESEND_API_KEY=
EMAIL_FROM=
