{
  "name": "@statuswatch/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./services/*": {
      "types": "./dist/services/*.d.ts",
      "import": "./dist/services/*.js"
    },
    "./repositories/*": {
      "types": "./dist/repositories/*.d.ts",
      "import": "./dist/repositories/*.js"
    },
    "./validators/*": {
      "types": "./dist/validators/*.d.ts",
      "import": "./dist/validators/*.js"
    },
    "./security/*": {
      "types": "./dist/security/*.d.ts",
      "import": "./dist/security/*.js"
    },
    "./checker/*": {
      "types": "./dist/checker/*.d.ts",
      "import": "./dist/checker/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./infrastructure/*": {
      "types": "./dist/infrastructure/*.d.ts",
      "import": "./dist/infrastructure/*.js"
    },
    "./notifications/*": {
      "types": "./dist/notifications/*.d.ts",
      "import": "./dist/notifications/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.47.14"
  }
}
